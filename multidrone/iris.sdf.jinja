    <!-- Downward rangefinder for DISTANCE_SENSOR. Nested name *sf10a* is how
         gazebo_mavlink_interface finds it. No collision — the stock sf10a box
         sat under the hull and snagged the pad (shiver, no lift). -->
    <model name="sf10a">
      <pose>0 0 -0.08 0 0 0</pose>
      <link name="link">
        <gravity>0</gravity>
        <inertial>
          <mass>1e-6</mass>
          <inertia>
            <ixx>1e-9</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1e-9</iyy>
            <iyz>0</iyz>
            <izz>1e-9</izz>
          </inertia>
        </inertial>
        <sensor name="sf10a" type="ray">
          <visualize>false</visualize>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <pose>0 0 0 0 1.5707963259 0</pose>
          <ray>
            <scan>
              <horizontal>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.06</min>
              <max>35</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
          <plugin name="LaserPlugin" filename="libgazebo_lidar_plugin.so">
            <robotNamespace></robotNamespace>
            <min_distance>0.1</min_distance>
            <max_distance>25.0</max_distance>
          </plugin>
        </sensor>
      </link>
    </model>
    <joint name="sf10a_joint" type="fixed">
      <parent>base_link</parent>
      <child>sf10a::link</child>
    </joint>
