<!-- DO NOT EDIT: Generated from iris.sdf.jinja -->
{%- set glow_port = gst_udp_port|default(5700)|int %}
{%- set glow_idx = (glow_port - 5700) % 4 %}
{%- set glow_mats = ['Gazebo/YellowGlow', 'Gazebo/BlueGlow', 'Gazebo/RedGlow', 'Gazebo/GreenGlow'] %}
{%- set glow_rs = [1.0, 0.15, 1.0, 0.25] %}
{%- set glow_gs = [0.85, 0.75, 0.25, 1.0] %}
{%- set glow_bs = [0.15, 1.0, 0.35, 0.3] %}
{%- set glow_mat = glow_mats[glow_idx] %}
{%- set glow_r = glow_rs[glow_idx] %}
{%- set glow_g = glow_gs[glow_idx] %}
{%- set glow_b = glow_bs[glow_idx] %}
<sdf version='1.6'>
  <model name='iris'>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.029125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.029125</iyy>
          <iyz>0</iyz>
          <izz>0.055225</izz>
        </inertia>
      </inertial>
      <collision name='base_link_inertia_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.47 0.47 0.11</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_inertia_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
          <emissive>{{ glow_r }} {{ glow_g }} {{ glow_b }} 1</emissive>
        </material>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
{%- if gst_udp_port is defined and gst_udp_port|int == 5700 %}
      <sensor name="hil_camera" type="camera">
        <pose>0.12 0 -0.08 0 {{ hil_cam_pitch_rad | default(0.785398163397) }} 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <!-- 1920x1080 @ 20 Hz HEVC RTP (iris_1 / gst_udp_port 5700 only). -->
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>200</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- 20 Hz 1080p HEVC ceiling, iris_1 only. Faster than 20 lags gzserver. -->
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <plugin name="GstCameraPlugin" filename="libgazebo_gst_camera_plugin.so">
          <robotNamespace></robotNamespace>
          <udpHost>10.42.0.11</udpHost>
          <udpPort>{{ gst_udp_port }}</udpPort>
        </plugin>
      </sensor>
{%- endif %}
      <!-- Operator marker (visual only). Overhead so it does not swallow iris_1's downward camera. -->
      <visual name="operator_glow_stem">
        <pose>0 0 0.9 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <transparency>0.25</transparency>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>1.4</length>
          </cylinder>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>{{ glow_mat }}</name>
          </script>
          <emissive>{{ glow_r }} {{ glow_g }} {{ glow_b }} 1</emissive>
        </material>
      </visual>
      <visual name="operator_glow_core">
        <pose>0 0 1.75 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <transparency>0.2</transparency>
        <geometry>
